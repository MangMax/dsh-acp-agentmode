{
  "name": "dsh-acp-agentmode",
  "version": "0.3.0",
  "private": true,
  "description": "Give `dsh --profile acp` a --agentmode <preset> flag that picks the agent preset every new ACP session runs.",
  "homepage": "https://github.com/MangMax/dsh-acp-agentmode#readme",
  "bugs": {
    "url": "https://github.com/MangMax/dsh-acp-agentmode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MangMax/dsh-acp-agentmode.git"
  },
  "files": [
    "dist",
    "presets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "smoke": "node scripts/smoke-acp.ts",
    "dev": "vp pack --watch",
    "sync-presets": "node scripts/sync-presets.ts",
    "verify": "vp check && vp test run && vp pack",
    "prepack": "pnpm verify"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  }
}
